NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://mcp:mcp@localhost:5435/mcp
# Public address of this server (no trailing slash). The MCP endpoint is $APP_URL/mcp.
APP_URL=http://localhost:3000
# Generate both with: npm run keys:generate
OAUTH_SIGNING_KEY=
COOKIE_SECRET=
ALLOW_DYNAMIC_REGISTRATION=true
ALLOW_CLIENT_METADATA_DOCUMENTS=true
# stdio mode only: the account the local server acts as
STDIO_USER_EMAIL=
