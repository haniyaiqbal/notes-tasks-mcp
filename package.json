{
  "name": "notes-tasks-mcp",
  "version": "0.0.1",
  "description": "MCP server for personal notes and tasks, with OAuth 2.1, scoped permissions, HTTP and stdio. NestJS + PostgreSQL",
  "author": "Haniya Iqbal",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "start:stdio": "node --env-file-if-exists=.env dist/stdio.js",
    "keys:generate": "node --import tsx scripts/generate-keys.ts",
    "inspector": "npx @modelcontextprotocol/inspector",
    "typeorm": "node --env-file-if-exists=.env --import tsx ./node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "migration:create": "node --import tsx ./node_modules/typeorm/cli.js migration:create",
    "migration:generate": "npm run typeorm -- migration:generate --pretty",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:check": "npm run typeorm -- migration:generate --check src/database/migrations/Check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/mcp": "^0.0.4",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/terminus": "^12.2.0",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/typeorm": "^12.0.3",
    "jose": "^6.2.18",
    "oidc-provider": "^9.15.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/oidc-provider": "^9.13.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
